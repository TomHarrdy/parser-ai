# ── Runtime ───────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
SCHEDULE_INTERVAL_MINUTES=60

# ── Database ──────────────────────────────────────────────────────────────────
# For Docker Compose: host = postgres (service name)
# For local run:      host = localhost
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@postgres:5432/DB_NAME

# ── Telegram ──────────────────────────────────────────────────────────────────
# Get token from @BotFather, chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_TARGET_CHAT_ID=your_chat_id_here

# ── Brand ─────────────────────────────────────────────────────────────────────
COMPANY_NAME=YourCompanyName
# Comma-separated keywords to narrow the search
KEYWORDS=keyword1,keyword2,keyword3
# Full phrases for independent searches (e.g. customer intent queries)
SEARCH_PHRASES=search phrase one,search phrase two
MONITORING_LOCATION=Moscow
MONITORING_LANGUAGES=ru

# ── LLM ───────────────────────────────────────────────────────────────────────
# Provider: openai | anthropic (set LLM_ENDPOINT accordingly for Anthropic)
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_api_key_here
LLM_ENDPOINT=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── Tools ─────────────────────────────────────────────────────────────────────
# Tavily  → https://tavily.com   (free tier: 1000 searches/month)
TAVILY_API_KEY=your_tavily_api_key_here
# Free/self-host web search fallback.
ENABLE_SEARXNG=true
SEARXNG_BASE_URL=http://searxng:8080
# Free-first page extraction uses local trafilatura, then Jina Reader.
# Change this to a self-hosted Jina Reader URL if needed.
JINA_READER_BASE_URL=https://r.jina.ai
# Optional paid fallback only; leave empty for free-first mode.
ENABLE_FIRECRAWL_FALLBACK=false
FIRECRAWL_API_KEY=
# Apify → https://apify.com       (free tier: $5/month credits)
APIFY_API_KEY=your_apify_api_key_here

# ── Apify Actors ──────────────────────────────────────────────────────────────
# VK handles or full VK URLs to monitor for posts.
# Example: pogruzhenye.official,https://vk.com/another_public
VK_TARGETS=

# ── Instagram Direct Parser ──────────────────────────────────────────────────
ENABLE_INSTAGRAM=false
INSTAGRAM_TARGETS=
INSTAGRAM_MAX_POSTS=5
INSTAGRAM_MAX_COMMENTS=20
INSTAGRAM_SESSION_USERNAME=
INSTAGRAM_SESSION_FILE=
# Yandex Maps organization ID — copy the number from the company URL on maps.yandex.ru
# Example: https://yandex.ru/maps/org/moykompany/1234567890/ → 1234567890
YANDEX_MAPS_ORG_ID=your_org_id_here
